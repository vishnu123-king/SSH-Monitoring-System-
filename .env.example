# ==========================================
# Linux SSH Security Monitor Environment Variables
# ==========================================

# Server Host & Port
API_HOST=127.0.0.1
API_PORT=8000

# SQLite Database Location
DATABASE_URL=sqlite:///./data/ssh_monitor.db

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Security Credentials (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_a_secure_random_key_min_32_chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_password_123!

# Detection Settings
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=120
BRUTE_FORCE_COOLDOWN_SECONDS=300

BURST_THRESHOLD=15
BURST_WINDOW_SECONDS=60

MULTIPLE_USERS_THRESHOLD=3
MULTIPLE_USERS_WINDOW_SECONDS=180

# Retention Policies
RETENTION_DAYS=30
ALERT_RETENTION_DAYS=90

# Target SSH Service ("auto", "ssh", "sshd")
SSH_SERVICE=auto
HOSTNAME=auto
